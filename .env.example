# Kopiera till .env och fyll i. Utan ANTHROPIC_API_KEY körs appen i DEMO-läge
# (påhittade exempelkort och regelbaserad värdering – bra för att prova flödet).

# --- AI-identifiering (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=
# Modell för identifiering och prisresearch (standard: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Låt Claude söka på webben efter sålda kort: "web" (standard) eller "off"
# PRICE_RESEARCH=web
# Tvinga demoläge även om nyckel finns: true/false
# DEMO_MODE=

# --- eBay (valfritt) -----------------------------------------------------------
# Skapa nycklar på https://developer.ebay.com (Production keyset)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US

# --- Säkerhet & kostnadskontroll -----------------------------------------------
# Om satt måste appen skicka headern x-app-token (anges under Inställningar i appen)
# APP_ACCESS_TOKEN=
# Max antal skanningar/värderingar per IP och tidsfönster
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=10 minutes

# --- Övrigt --------------------------------------------------------------------
# PORT=8787
# HOST=0.0.0.0
# DEFAULT_CURRENCY=SEK
# Kostnad för att gradera ett kort inkl. frakt, i SEK (används i graderingsrådet)
# GRADING_COST_SEK=350
# Växelkurser (ECB via Frankfurter). "off" = använd inbyggda reservkurser
# FX_URL=https://api.frankfurter.dev/v1/latest?base=USD
# LOG_LEVEL=info
