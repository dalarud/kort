{
  "name": "kortkollen",
  "version": "1.0.0",
  "private": true,
  "description": "Kortkollen – värdera fotbollskort med mobilkameran",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:phone": "npm run dev --workspace server & npm run dev:https --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
